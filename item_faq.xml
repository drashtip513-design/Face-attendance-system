<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:id="@+id/tvQ" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/text_dark" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvArrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="›" android:textColor="@color/text_gray" android:textSize="18sp" />
    </LinearLayout>

    <TextView android:id="@+id/tvA" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/text_gray" android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>